{
  "name": "railway-express-postgres",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "dev": "PORT=3006 tsx watch src/server.ts",
    "lint": "tsc --noEmit",

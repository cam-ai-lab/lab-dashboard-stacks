{
  "name": "firebase-hosting-functions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "dev": "pnpm build && firebase emulators:start --only hosting,functions,firestore",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dashboard/shared": "workspace:*",
    "express": "^5.1.0",
    "firebase-admin": "^13.3.0",
    "firebase-functions": "^6.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "firebase-tools": "^14.0.0",
    "supertest": "^7.1.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "engines": { "node": "22" }
}
